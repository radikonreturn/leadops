DATABASE_URL=postgresql://leadops:change-me@localhost:5432/leadops
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=true

# Security & Server-Side Encryption (Fernet 32-byte urlsafe base64 key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
SECRET_KEY=leadops-session-secret-change-in-production

# OAuth Application Redirect Base URL
OAUTH_REDIRECT_BASE_URL=http://localhost:3000/settings/ai-providers/callback

# Google Gemini OAuth 2.0 Credentials (Optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OpenRouter OAuth PKCE Client ID (Optional)
OPENROUTER_OAUTH_CLIENT_ID=
